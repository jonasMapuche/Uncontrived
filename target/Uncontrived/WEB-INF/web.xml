<web-app xmlns="http://jcp.org"
         xmlns:xsi="http://w3.org"
         xsi:schemaLocation="http://jcp.org http://jcp.org/web-app_4_0.xsd"
         version="4.0">
         
	<servlet>
  	<servlet-name>JerseyWebServices</servlet-name>
    <servlet-class>org.glassfish.jersey.servlet.ServletContainer</servlet-class>
		<init-param>
    	<param-name>jersey.config.server.provider.packages</param-name>
      <param-value>br.com.stomach.Uncontrived.controllers</param-value>
		</init-param>
    <load-on-startup>1</load-on-startup>
	</servlet>
    
 	<servlet-mapping>
  	<servlet-name>JerseyWebServices</servlet-name>
    <url-pattern>/*</url-pattern>
	</servlet-mapping>

</web-app>
